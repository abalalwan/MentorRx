# Copy this file to .env.local and fill in real values.

# Supabase — required (Settings → API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Payments — pick a default provider; both can be wired up via src/lib/payments
DEFAULT_PAYMENT_PROVIDER=hyperpay
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_CREDIT=
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Video — pick a default provider; zoom, teams, and google_meet are all supported
DEFAULT_VIDEO_PROVIDER=zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=
TEAMS_ORGANIZER_ID=
GOOGLE_ACCESS_TOKEN=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@mentorrx.com
